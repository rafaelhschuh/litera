# Copy to .env and replace the password before the first startup.
LITERA_ADMIN_USERNAME=admin
LITERA_ADMIN_PASSWORD=replace-with-a-long-random-password
LITERA_BOOKS_PATH=./books
LITERA_PORT=3000
LITERA_SECURE_COOKIES=false
# Optional, disabled by default. Set both values for low-volume enrichment.
LITERA_OPENLIBRARY_ENABLED=false
LITERA_OPENLIBRARY_CONTACT=you@example.com
LITERA_MAX_BOOK_MB=512
